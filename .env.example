# API keys of the controllers in models.json. Copy this file to .env and fill in
# the keys of the controllers you use; the others are shown as unavailable.

# GPT 5.6 Sol (OpenAI API)
OPENAI_API_KEY=

# Gemma 4 31B and Gemma 3 12B IT (Amazon Bedrock API key)
AWS_BEARER_TOKEN_BEDROCK=
AWS_REGION=us-east-1
